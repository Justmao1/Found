# Enable only after checking all four S8050 stages and BCM pin assignments.
# Install as ~/lost-found-box/config/lockers.env for the systemd service.
LOST_FOUND_LOCKER_MODE=gpio
LOST_FOUND_LOCKER_GPIO_MAP=01=17,02=26,03=13,04=5
# Compartment 01 only: BCM12 (physical 32), dry contact to GND; LOW means latched.
# Enable after wiring is checked. Other compartments retain manual confirmation.
LOST_FOUND_DOOR_FEEDBACK_ENABLED=0
